<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <timestamp key="RUN_TS" datePattern="yyyyMMdd_HHmmss"/>
    <property name="LOG_DIR" value="test-output/logs"/>
    <property name="LOG_FILE" value="${LOG_DIR}/test-run-${RUN_TS}.log"/>
    <property name="LOG_LEVEL" value="${log.level:-INFO}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %-20.20logger{0} | %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_FILE}</file>
        <append>false</append>
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %-20.20logger{0} | %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="TestLog" level="INFO" additivity="true"/>
    <logger name="org.openqa.selenium" level="WARN"/>
    <logger name="io.github.bonigarcia.wdm" level="INFO"/>
    <logger name="com.aventstack.extentreports" level="WARN"/>

    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
