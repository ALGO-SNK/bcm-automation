<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Regression Test Suite (30-60 minutes)
    Full test coverage for comprehensive validation.

    Usage:
      mvn test -DsuiteXmlFile=regression.xml
-->
<suite name="Regression-Suite" parallel="methods" thread-count="4" verbose="1">

    <parameter name="BASE_URL"   value="https://mis-release.bromcom.dev/"/>
    <parameter name="BROWSER"    value="chrome"/>
    <parameter name="RESOLUTION" value="FULL_HD"/>

    <listeners>
        <listener class-name="com.brcm.utils.TestListener"/>
    </listeners>

    <test name="Regression-Tests">
        <groups><run><include name="ui"/></run></groups>
        <classes>
            <class name="com.brcm.LoginTest"/>
            <class name="com.brcm.DashboardTest"/>
        </classes>
    </test>
</suite>
