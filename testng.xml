<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SK-Vtiger-Automation-Suite" parallel="tests" thread-count="3" verbose="1">
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="UI-Tests">
        <groups>
            <run>
                <include name="ui"/>
            </run>
        </groups>
        <classes>
            <class name="tests.ui.LoginTest"/>
        </classes>
    </test>

    <test name="API-Tests">
        <groups>
            <run>
                <include name="api"/>
            </run>
        </groups>
        <classes>
            <class name="tests.api.UserAPITest"/>
        </classes>
    </test>

    <test name="Integration-Tests">
        <groups>
            <run>
                <include name="integration"/>
            </run>
        </groups>
        <classes>
            <class name="tests.integration.UserFlowTest"/>
        </classes>
    </test>
</suite>
